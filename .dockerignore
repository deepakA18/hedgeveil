# Only backend source and public build inputs enter the Docker context.
**
!railway.json
!Dockerfile
!.dockerignore
!apps/
!apps/web/
!apps/web/**
!services/
!services/**
!packages/
!packages/**
!tests/
!tests/sandbox/
!tests/sandbox/package.json
!tests/sandbox/package-lock.json
!tests/indexer/
!tests/indexer/postgres.mjs
!deploy/
!deploy/container/
!deploy/container/**
!deploy/testnet/
!deploy/testnet/expiry-deployment.json
**/node_modules/**
**/.local/**
**/.env*
**/.git/**
**/target/**
**/__pycache__/**
**/.venv/**
**/*.pem
**/*.key
services/subquery/**
