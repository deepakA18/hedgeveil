# Optional public homepage destination, evaluated at build time.
HEDGEVEIL_DESK_URL=/trade
# Server-only local bridge configuration. Use 127.0.0.1, not localhost.
HEDGEVEIL_FRONTEND_ORIGIN=http://127.0.0.1:3000
HEDGEVEIL_BACKEND_ORIGIN=http://127.0.0.1:8794
# For the separately funded layout-2 TWAP desk, use http://127.0.0.1:8796.
# Existing balances remain on the legacy desk; changing this origin never migrates funds.
# Never copy root .env, wallet keys or service tokens into this app.
