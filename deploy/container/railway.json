{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/container/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "requiredMountPath": "/app/.local/testnet",
    "restartPolicyType": "NEVER",
    "overlapSeconds": 0,
    "drainingSeconds": 150
  }
}
