{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgeveil.invalid/schemas/expiry-oracle/native-trade-twap-v1",
  "title": "Candidate historical trade TWAP resolver; production disabled",
  "oneOf": [
    {
      "$ref": "#/$defs/registration"
    },
    {
      "$ref": "#/$defs/case"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/snapshot"
    }
  ],
  "$defs": {
    "uint128": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^(0|[1-9][0-9]{0,38})(?![\\s\\S])"
    },
    "uint64": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
    },
    "positive": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[1-9][0-9]{0,38}(?![\\s\\S])"
    },
    "account": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*(?![\\s\\S])"
    },
    "hash256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "series_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "version",
        "collateral_kind",
        "index_definition_hash",
        "payoff_kind",
        "strike",
        "price_scale",
        "maturity_ns",
        "mint_cutoff_ns",
        "observation_window",
        "oracle_account_id",
        "oracle_version",
        "oracle_config_hash",
        "finalization_policy_hash",
        "max_supply"
      ],
      "properties": {
        "series_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "const": "1"
        },
        "collateral_kind": {
          "const": "NATIVE_NEAR"
        },
        "index_definition_hash": {
          "$ref": "#/$defs/hash256"
        },
        "payoff_kind": {
          "const": "CAPPED_USD_COMPLEMENT"
        },
        "strike": {
          "$ref": "#/$defs/positive"
        },
        "price_scale": {
          "const": "1000000000000"
        },
        "maturity_ns": {
          "$ref": "#/$defs/uint64"
        },
        "mint_cutoff_ns": {
          "$ref": "#/$defs/uint64"
        },
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_ns",
            "end_ns"
          ],
          "properties": {
            "start_ns": {
              "$ref": "#/$defs/uint64"
            },
            "end_ns": {
              "$ref": "#/$defs/uint64"
            }
          }
        },
        "oracle_account_id": {
          "$ref": "#/$defs/account"
        },
        "oracle_version": {
          "const": "native-trade-twap-v1"
        },
        "oracle_config_hash": {
          "$ref": "#/$defs/hash256"
        },
        "finalization_policy_hash": {
          "$ref": "#/$defs/hash256"
        },
        "max_supply": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "evidence_sha256",
        "response_sha256",
        "accepted_ns"
      ],
      "properties": {
        "price": {
          "$ref": "#/$defs/positive"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/hash256"
        },
        "response_sha256": {
          "$ref": "#/$defs/hash256"
        },
        "accepted_ns": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "$ref": "#/$defs/series_terms"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "pending",
        "accepted",
        "price",
        "last_result"
      ],
      "properties": {
        "config": {
          "$ref": "#/$defs/series_terms"
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted": {
          "anyOf": [
            {
              "$ref": "#/$defs/accepted"
            },
            {
              "type": "null"
            }
          ]
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/positive"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_result": {
          "enum": [
            "NOT_REQUESTED",
            "PENDING",
            "REJECTED",
            "ACCEPTED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "last_result": {
                "const": "ACCEPTED"
              }
            }
          },
          "then": {
            "properties": {
              "pending": {
                "type": "null"
              },
              "accepted": {
                "$ref": "#/$defs/accepted"
              }
            }
          },
          "else": {
            "properties": {
              "accepted": {
                "type": "null"
              },
              "price": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "last_result": {
                "const": "PENDING"
              }
            }
          },
          "then": {
            "properties": {
              "pending": {
                "$ref": "#/$defs/uint64"
              }
            }
          },
          "else": {
            "properties": {
              "pending": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "version",
        "event",
        "data"
      ],
      "properties": {
        "standard": {
          "const": "hedgeveil_expiry_oracle"
        },
        "version": {
          "const": "1.0.0"
        },
        "event": {
          "enum": [
            "INITIALIZED",
            "SERIES_REGISTERED",
            "EVIDENCE_REQUESTED",
            "EVIDENCE_ACCEPTED",
            "EVIDENCE_REJECTED",
            "FINALIZED",
            "PAUSE_CHANGED",
            "CASE_ARCHIVED"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network",
              "contract_id",
              "sequence",
              "state_hash"
            ],
            "properties": {
              "network": {
                "enum": [
                  "sandbox",
                  "testnet"
                ]
              },
              "contract_id": {
                "$ref": "#/$defs/account"
              },
              "sequence": {
                "$ref": "#/$defs/uint64"
              },
              "state_hash": {
                "$ref": "#/$defs/hash256"
              }
            }
          },
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "contract_id",
        "sequence",
        "version",
        "registrar",
        "guardian",
        "source",
        "worker_sha256",
        "request_sequence",
        "paused",
        "cases"
      ],
      "properties": {
        "network": {
          "enum": [
            "sandbox",
            "testnet"
          ]
        },
        "contract_id": {
          "$ref": "#/$defs/account"
        },
        "sequence": {
          "$ref": "#/$defs/uint64"
        },
        "version": {
          "const": "native-trade-twap-v1"
        },
        "registrar": {
          "$ref": "#/$defs/account"
        },
        "guardian": {
          "$ref": "#/$defs/account"
        },
        "source": {
          "$ref": "#/$defs/account"
        },
        "worker_sha256": {
          "const": "86b6d24556ca55356ff37421cbcbcf3a8e021d543fbdb04bb3a55d6ec365ac43"
        },
        "request_sequence": {
          "$ref": "#/$defs/uint64"
        },
        "paused": {
          "type": "boolean"
        },
        "cases": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/case"
          }
        },
        "layout_version": {
          "const": 2
        },
        "archived_count": {
          "$ref": "#/$defs/uint64"
        },
        "archive_commitment": {
          "$ref": "#/$defs/hash256"
        }
      },
      "dependentRequired": {
        "layout_version": [
          "archived_count",
          "archive_commitment"
        ],
        "archived_count": [
          "layout_version",
          "archive_commitment"
        ],
        "archive_commitment": [
          "layout_version",
          "archived_count"
        ]
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "layout_version"
              ]
            }
          },
          "then": {
            "properties": {
              "cases": {
                "maxProperties": 16
              }
            }
          }
        }
      ]
    }
  }
}
