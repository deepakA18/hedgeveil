{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgeveil.invalid/schemas/public-ledger/0.2.0",
  "title": "Open Innovation public-ledger draft (not deployed ABI)",
  "oneOf": [
    {
      "$ref": "#/$defs/transaction"
    },
    {
      "$ref": "#/$defs/quote"
    },
    {
      "$ref": "#/$defs/pair_quote"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/withdrawal"
    }
  ],
  "$defs": {
    "uint128": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^(0|[1-9][0-9]{0,38})(?![\\s\\S])"
    },
    "positive": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[1-9][0-9]{0,38}(?![\\s\\S])"
    },
    "uint64": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
    },
    "account": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*(?![\\s\\S])"
    },
    "hash256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 44,
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}(?![\\s\\S])"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "network",
        "contract_id"
      ],
      "properties": {
        "protocol_version": {
          "const": "1"
        },
        "network": {
          "enum": [
            "sandbox",
            "testnet"
          ]
        },
        "contract_id": {
          "$ref": "#/$defs/account"
        }
      }
    },
    "asset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "COLLATERAL"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "series_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "P",
                "N"
              ]
            },
            "series_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "vault_id"
          ],
          "properties": {
            "kind": {
              "const": "VAULT_SHARE"
            },
            "vault_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "amount"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "amount": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "amount"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "amount": {
          "$ref": "#/$defs/uint128"
        }
      }
    },
    "series_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "version",
        "collateral_kind",
        "index_definition_hash",
        "payoff_kind",
        "strike",
        "price_scale",
        "maturity_ns",
        "mint_cutoff_ns",
        "observation_window",
        "oracle_account_id",
        "oracle_version",
        "oracle_config_hash",
        "finalization_policy_hash",
        "max_supply"
      ],
      "properties": {
        "series_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "const": "1"
        },
        "collateral_kind": {
          "const": "NATIVE_NEAR"
        },
        "index_definition_hash": {
          "$ref": "#/$defs/hash256"
        },
        "payoff_kind": {
          "const": "CAPPED_USD_COMPLEMENT"
        },
        "strike": {
          "$ref": "#/$defs/positive"
        },
        "price_scale": {
          "const": "1000000000000"
        },
        "maturity_ns": {
          "$ref": "#/$defs/uint64"
        },
        "mint_cutoff_ns": {
          "$ref": "#/$defs/uint64"
        },
        "observation_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_ns",
            "end_ns"
          ],
          "properties": {
            "start_ns": {
              "$ref": "#/$defs/uint64"
            },
            "end_ns": {
              "$ref": "#/$defs/uint64"
            }
          }
        },
        "oracle_account_id": {
          "$ref": "#/$defs/account"
        },
        "oracle_version": {
          "$ref": "#/$defs/id"
        },
        "oracle_config_hash": {
          "$ref": "#/$defs/hash256"
        },
        "finalization_policy_hash": {
          "$ref": "#/$defs/hash256"
        },
        "max_supply": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "domain",
        "maker",
        "taker",
        "maker_gives",
        "taker_gives",
        "fee",
        "fill_rule",
        "rounding",
        "nonce",
        "cancellation_epoch",
        "expiry_ns",
        "signing_key_id",
        "signature_scheme",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "quote"
        },
        "schema_version": {
          "const": "0.2.0"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "maker": {
          "$ref": "#/$defs/account"
        },
        "taker": {
          "anyOf": [
            {
              "$ref": "#/$defs/account"
            },
            {
              "type": "null"
            }
          ]
        },
        "maker_gives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leg"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "taker_gives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leg"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "fee": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset",
            "amount",
            "receiver"
          ],
          "properties": {
            "asset": {
              "const": "NATIVE_NEAR"
            },
            "amount": {
              "$ref": "#/$defs/uint128"
            },
            "receiver": {
              "$ref": "#/$defs/account"
            }
          }
        },
        "fill_rule": {
          "const": "ALL_OR_NOTHING"
        },
        "rounding": {
          "const": "EXACT_AMOUNTS"
        },
        "nonce": {
          "$ref": "#/$defs/uint64"
        },
        "cancellation_epoch": {
          "$ref": "#/$defs/uint64"
        },
        "expiry_ns": {
          "$ref": "#/$defs/uint64"
        },
        "signing_key_id": {
          "$ref": "#/$defs/id"
        },
        "signature_scheme": {
          "const": "ed25519"
        },
        "signature": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[0-9a-f]{128}(?![\\s\\S])"
        }
      }
    },
    "pair_quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "domain",
        "maker",
        "taker",
        "fee",
        "fill_rule",
        "rounding",
        "nonce",
        "cancellation_epoch",
        "expiry_ns",
        "signing_key_id",
        "signature_scheme",
        "signature",
        "series_id",
        "pair_amount",
        "maker_leg",
        "maker_collateral"
      ],
      "properties": {
        "kind": {
          "const": "pair_quote"
        },
        "schema_version": {
          "const": "0.2.0"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "maker": {
          "$ref": "#/$defs/account"
        },
        "taker": {
          "anyOf": [
            {
              "$ref": "#/$defs/account"
            },
            {
              "type": "null"
            }
          ]
        },
        "fee": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset",
            "amount",
            "receiver"
          ],
          "properties": {
            "asset": {
              "const": "NATIVE_NEAR"
            },
            "amount": {
              "$ref": "#/$defs/uint128"
            },
            "receiver": {
              "$ref": "#/$defs/account"
            }
          }
        },
        "fill_rule": {
          "const": "ALL_OR_NOTHING"
        },
        "rounding": {
          "const": "EXACT_AMOUNTS"
        },
        "nonce": {
          "$ref": "#/$defs/uint64"
        },
        "cancellation_epoch": {
          "$ref": "#/$defs/uint64"
        },
        "expiry_ns": {
          "$ref": "#/$defs/uint64"
        },
        "signing_key_id": {
          "$ref": "#/$defs/id"
        },
        "signature_scheme": {
          "const": "ed25519"
        },
        "signature": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[0-9a-f]{128}(?![\\s\\S])"
        },
        "series_id": {
          "$ref": "#/$defs/id"
        },
        "pair_amount": {
          "$ref": "#/$defs/positive"
        },
        "maker_leg": {
          "enum": [
            "P",
            "N"
          ]
        },
        "maker_collateral": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "domain",
        "operation_id",
        "attached_deposit",
        "method",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "transaction"
        },
        "schema_version": {
          "const": "0.2.0"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "operation_id": {
          "$ref": "#/$defs/hash256"
        },
        "attached_deposit": {
          "$ref": "#/$defs/uint128"
        },
        "method": {
          "enum": [
            "configure_vault_roll",
            "publish_vault_reference",
            "execute_vault_roll",
            "deposit_collateral",
            "storage_deposit",
            "release_storage_excess",
            "unregister",
            "close_ticket",
            "release_dust",
            "archive_series",
            "set_pauses",
            "create_series",
            "split",
            "merge",
            "transfer",
            "redeem",
            "fill_quote",
            "match_pair",
            "register_signing_key",
            "revoke_signing_key",
            "advance_quote_epoch",
            "set_market_pause",
            "cancel_quote",
            "request_resolution",
            "request_withdrawal",
            "create_vault",
            "set_vault_mint_pause",
            "transfer_vault_shares",
            "vault_mint_basket",
            "vault_redeem_in_kind"
          ]
        },
        "args": {
          "type": "object"
        },
        "storage_deposit": {
          "$ref": "#/$defs/positive"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "storage_deposit"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "const": "deposit_collateral"
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "method": {
              "const": "configure_vault_roll"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy"
              ],
              "properties": {
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "keeper",
                    "reference_publisher",
                    "fee_receiver",
                    "old_series_id",
                    "new_series_id",
                    "not_before_ns",
                    "deadline_ns",
                    "min_remaining_ns",
                    "max_remaining_ns",
                    "max_reference_age_ns",
                    "quote_horizon_ns",
                    "max_notional",
                    "max_cash_input",
                    "max_fee",
                    "total_fee_budget",
                    "total_loss_budget",
                    "min_receive",
                    "max_loss_bps"
                  ],
                  "properties": {
                    "version": {
                      "const": "roll-demo-v1"
                    },
                    "keeper": {
                      "$ref": "#/$defs/account"
                    },
                    "reference_publisher": {
                      "$ref": "#/$defs/account"
                    },
                    "fee_receiver": {
                      "$ref": "#/$defs/account"
                    },
                    "old_series_id": {
                      "$ref": "#/$defs/id"
                    },
                    "new_series_id": {
                      "$ref": "#/$defs/id"
                    },
                    "not_before_ns": {
                      "$ref": "#/$defs/uint64"
                    },
                    "deadline_ns": {
                      "$ref": "#/$defs/uint64"
                    },
                    "min_remaining_ns": {
                      "$ref": "#/$defs/uint64"
                    },
                    "max_remaining_ns": {
                      "$ref": "#/$defs/uint64"
                    },
                    "max_reference_age_ns": {
                      "$ref": "#/$defs/uint64"
                    },
                    "quote_horizon_ns": {
                      "$ref": "#/$defs/uint64"
                    },
                    "max_notional": {
                      "$ref": "#/$defs/uint128"
                    },
                    "max_cash_input": {
                      "$ref": "#/$defs/uint128"
                    },
                    "max_fee": {
                      "$ref": "#/$defs/uint128"
                    },
                    "total_fee_budget": {
                      "$ref": "#/$defs/uint128"
                    },
                    "total_loss_budget": {
                      "$ref": "#/$defs/uint128"
                    },
                    "min_receive": {
                      "$ref": "#/$defs/uint128"
                    },
                    "max_loss_bps": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "publish_vault_reference"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference"
              ],
              "properties": {
                "reference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sequence",
                    "observed_ns",
                    "old_price",
                    "new_price"
                  ],
                  "properties": {
                    "sequence": {
                      "$ref": "#/$defs/uint64"
                    },
                    "observed_ns": {
                      "$ref": "#/$defs/uint64"
                    },
                    "old_price": {
                      "$ref": "#/$defs/positive"
                    },
                    "new_price": {
                      "$ref": "#/$defs/positive"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "execute_vault_roll"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote",
                "reference_sequence"
              ],
              "properties": {
                "quote": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/quote"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reference_sequence": {
                  "$ref": "#/$defs/uint64"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "deposit_collateral"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "storage_deposit"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "release_storage_excess"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "$ref": "#/$defs/positive"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "unregister"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "close_ticket"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ticket_id"
              ],
              "properties": {
                "ticket_id": {
                  "$ref": "#/$defs/uint64"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "release_dust"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "series_id"
              ],
              "properties": {
                "series_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "archive_series"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "series_id"
              ],
              "properties": {
                "series_id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "set_pauses"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pauses"
              ],
              "properties": {
                "pauses": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "deposits",
                    "series",
                    "splits"
                  ],
                  "properties": {
                    "deposits": {
                      "type": "boolean"
                    },
                    "series": {
                      "type": "boolean"
                    },
                    "splits": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "create_series"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "config"
              ],
              "properties": {
                "config": {
                  "$ref": "#/$defs/series_terms"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "split"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "series_id",
                "amount"
              ],
              "properties": {
                "series_id": {
                  "$ref": "#/$defs/id"
                },
                "amount": {
                  "$ref": "#/$defs/positive"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "merge"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "series_id",
                "amount"
              ],
              "properties": {
                "series_id": {
                  "$ref": "#/$defs/id"
                },
                "amount": {
                  "$ref": "#/$defs/positive"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "transfer"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset",
                "amount",
                "receiver"
              ],
              "properties": {
                "asset": {
                  "$ref": "#/$defs/asset"
                },
                "amount": {
                  "$ref": "#/$defs/positive"
                },
                "receiver": {
                  "$ref": "#/$defs/account"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "redeem"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "series_id",
                "leg",
                "amount"
              ],
              "properties": {
                "series_id": {
                  "$ref": "#/$defs/id"
                },
                "leg": {
                  "enum": [
                    "P",
                    "N"
                  ]
                },
                "amount": {
                  "$ref": "#/$defs/positive"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "fill_quote"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote"
              ],
              "properties": {
                "quote": {
                  "$ref": "#/$defs/quote"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "match_pair"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote"
              ],
              "properties": {
                "quote": {
                  "$ref": "#/$defs/pair_quote"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "register_signing_key"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key_id",
                "public_key"
              ],
              "properties": {
                "key_id": {
                  "$ref": "#/$defs/id"
                },
                "public_key": {
                  "$ref": "#/$defs/hash256"
                }
              }
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "revoke_signing_key"
