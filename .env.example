# Open Innovation: development and the core demo require no paid API keys.
# Reserved environment settings for future persistent UI/demo tooling.
# Current SDK/indexer commands read explicit JSON config; they do not load .env.
HEDGEVEIL_MODE=sandbox
NEAR_NETWORK_ID=sandbox
NEAR_RPC_URL=http://127.0.0.1:3030
# Set after deploying the new public-ledger contracts. No default deployment.
CLEARINGHOUSE_ACCOUNT_ID=
SETTLEMENT_ORACLE_ACCOUNT_ID=
# Explicit testnet mode uses faucet funds and DEMO ORACLE — SYNTHETIC PRICES.
# Existing local .env values are user-managed; this template does not migrate secrets.


# INF-01 explicit JSON --config template (remove the leading "# " to copy).
# Fill actual local deployment pins and a private local DB password in an ignored file.
# Never save a real password here. These placeholders are not a deployment record.
# {
#   "network": "sandbox",
#   "chain_id": "<actual chain ID>",
#   "genesis_hash": "<actual genesis hash>",
#   "anchor_hash": "<finalized block immediately before watched deployments>",
#   "rpc_urls": ["http://127.0.0.1:3030/"],
#   "contracts": [
#     {"account_id": "core.sandbox", "kind": "core", "code_hash": "<base58 deployed Wasm SHA-256>"},
#     {"account_id": "oracle.sandbox", "kind": "oracle", "code_hash": "<base58 deployed Wasm SHA-256>"}
#   ],
#   "postgres": {"host": "127.0.0.1", "port": 5432, "database": "hedgeveil", "user": "hedgeveil", "password": "<local DB password>"},
#   "schema": "hv_indexer",
#   "api_port": 8787,
#   "max_blocks": 2000,
#   "max_events": 20000,
#   "timeout_ms": 15000,
#   "poll_ms": 1000,
#   "max_lag_blocks": 64,
#   "stale_after_ms": 30000
# }
# The optional numeric entries above show service defaults.
# Maximums: max_blocks 10000, max_events 100000, timeout_ms/poll_ms 60000,
# max_lag_blocks 10000, stale_after_ms 300000; API binds loopback only.
