# Open Innovation: local development/tests require no paid API keys.
# Reserved environment settings for future persistent UI/demo tooling.
# Current SDK/indexer commands read explicit JSON config; they do not load .env.
HEDGEVEIL_MODE=sandbox
NEAR_NETWORK_ID=sandbox
NEAR_RPC_URL=http://127.0.0.1:3030
# Set after deploying the new public-ledger contracts. No default deployment.
CLEARINGHOUSE_ACCOUNT_ID=
SETTLEMENT_ORACLE_ACCOUNT_ID=
# Public testnet requires accepted external data; fixture-only setup remains held.
# Existing local .env values are user-managed; this template does not migrate secrets.


# INF-01 explicit JSON --config template (remove the leading "# " to copy).
# Fill actual local deployment pins and a private local DB password in an ignored file.
# Never save a real password here. These placeholders are not a deployment record.
# {
#   "network": "sandbox",
#   "chain_id": "<actual chain ID>",
#   "genesis_hash": "<actual genesis hash>",
#   "anchor_hash": "<finalized block immediately before watched deployments>",
#   "rpc_urls": ["http://127.0.0.1:3030/"],
#   "contracts": [
#     {"account_id": "core.sandbox", "kind": "core", "code_hash": "<base58 deployed Wasm SHA-256>"},
#     {"account_id": "oracle.sandbox", "kind": "oracle", "code_hash": "<base58 deployed Wasm SHA-256>"}
#   ],
#   "postgres": {"host": "127.0.0.1", "port": 5432, "database": "hedgeveil", "user": "hedgeveil", "password": "<local DB password>"},
#   "schema": "hv_indexer",
#   "api_port": 8787,
#   "max_blocks": 2000,
#   "max_events": 20000,
#   "timeout_ms": 15000,
#   "request_interval_ms": 0,
#   "read_concurrency": 4,
#   "poll_ms": 1000,
#   "max_lag_blocks": 64,
#   "stale_after_ms": 30000
# }
# The optional numeric entries above show Sandbox service defaults.
# Testnet request_interval_ms defaults to 250; HTTP 429 respects Retry-After
# or waits 60 seconds before trying that provider again. These are JSON fields.
# Maximums: max_blocks 10000, max_events 100000, timeout_ms/poll_ms 60000,
# max_lag_blocks 10000, stale_after_ms 300000; API binds loopback only.

# APP-02 local launcher (no environment-variable loading):
# Programmatic startDemo options: port = 0 (random loopback port), poll = true.
# Indexer poll interval = 2000 ms; stale_after_ms = 30000; max_blocks = 10000.
# Synthetic observation start = current finalized time + 3600 seconds.
# Synthetic maker marks: P:alpha = 0.5, N:alpha = 0.5 native collateral/claim.
# All keys are ephemeral in memory; client.json contains only public deployment
# binding. Browser/server journals use the fresh ignored target/app02-* directory.
# No public network, existing wallet, paid-service fallback or production mode.

# DEM-01 retained local mode: node scripts/demo.mjs create|resume|inspect <name>.
# No .env loading. Names map to ignored target/demos/<name>; no overwrite/reset.
# RPC, network, PostgreSQL and UI ports are chosen at create and retained.
# Generated account/RFQ keys and DB password are local private (0600) files.
# Optional trusted maker IPC fields: state_file (absolute private JSON path),
# resume (true requires existing state); defaults omit both for ephemeral workers.
# Runtime remains Sandbox 2.14.0, PostgreSQL 18.6, epoch_length 1000000.

# ORC-03 offline signed intake: no environment variables or API key.
# Explicit CLI --public-key pin; --archive directory; 60-second current age bound.
# No paid request or .env loading; see services/outlayer/README.md.

# Optional explicit testnet indexer JSON field: header_source = "neardata-testnet".
# Omitted by default. Uses public hosted header hints; pinned RPC final head,
# complete ancestry and receipt/custody checks are still required.
# Native retained plan may select indexer_transaction_filter = "journal-roots"
# and its own indexer_schema. Requires admin/wallet journal discovery; it cannot
# automatically discover transactions made outside that local demo.
# OnFinality SubQuery package publishing; optional, no default. Never commit tokens.
SUBQL_ACCESS_TOKEN=

# Hosted gateway (opt-in). Unset HEDGEVEIL_HOSTED_MODE keeps strict loopback mode.
# Set these server-side on BOTH Vercel and the single backend. Never NEXT_PUBLIC_.
# Use the exact final HTTPS origins, without a path, credentials or query.
# Local defaults: frontend http://127.0.0.1:3000, backend http://127.0.0.1:8794.
# For the current local expiry desk set backend http://127.0.0.1:8796 explicitly.
HEDGEVEIL_HOSTED_MODE=
HEDGEVEIL_FRONTEND_ORIGIN=http://127.0.0.1:3000
HEDGEVEIL_BACKEND_ORIGIN=http://127.0.0.1:8794
# Required in hosted mode: same independently generated 32 random bytes encoded
# as 64 lowercase hexadecimal characters on both servers. Store only in secrets.
HEDGEVEIL_BRIDGE_SECRET=

# Railway migration only: 1 holds workers before state restoration; default unset/0 runs guarded startup.
HEDGEVEIL_MIGRATION_HOLD=

# Railway single signer deployment policy. Host settings, not application logic.
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=150
